# 24 GB card (e.g. L4, A10, RTX 4090). Same as the .env.example defaults.
# PLAN section 4: vLLM 12 GB (5.6 weights + ~2 activations + ~4.4 KV, ~78k
# tokens), Speaches ~5 GB, ~7 GB headroom. 10+ concurrent calls.
VLLM_GPU_MEMORY_UTILIZATION=0.50
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=16
WHISPER_COMPUTE_TYPE=float16
