# 16 GB card (e.g. T4, A4000). Tight: about 5 concurrent calls.
# PLAN section 4: vLLM 8.8 GB (5.6 weights + ~1.5 activations + ~1.7 KV,
# ~30k tokens), Speaches ~4 GB with Whisper int8_float16, ~3 GB headroom.
# Set Dograh DEFAULT_ORG_CONCURRENCY_LIMIT to match the measured capacity.
VLLM_GPU_MEMORY_UTILIZATION=0.55
VLLM_MAX_MODEL_LEN=6144
VLLM_MAX_NUM_SEQS=8
WHISPER_COMPUTE_TYPE=int8_float16
