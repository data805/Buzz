# 48 GB card (e.g. L40S, A6000).
# PLAN section 4: vLLM 19 GB (5.6 weights + ~2 activations + ~11 KV),
# Speaches ~5 GB, ~24 GB headroom kept for a larger LLM or a Bemba/Nyanja STT
# model (Phase 7). Raise VLLM_MAX_NUM_SEQS only after the Phase 6 load test.
VLLM_GPU_MEMORY_UTILIZATION=0.40
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=16
WHISPER_COMPUTE_TYPE=float16
