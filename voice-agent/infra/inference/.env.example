# Buzz inference host environment. Copy to .env (git-ignored) and fill in.
# Names follow docs/INTERFACES.md. Compose refuses to start while a required
# value (marked "required") is empty.

# --- Network -----------------------------------------------------------------
# required. LAN IP of this server. vLLM (8000), Speaches (8001), DCGM exporter
# (9400) and node-exporter (9100) bind to this address only.
INFERENCE_LAN_IP=

# --- Secrets -----------------------------------------------------------------
# required. Bearer keys. Generate each with: openssl rand -hex 32
# The same values go into the app host's provider bootstrap.
VLLM_API_KEY=
SPEACHES_API_KEY=

# --- Models ------------------------------------------------------------------
# Hugging Face repo vLLM loads (not in INTERFACES.md: inference host only).
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
# Name clients use in "model". Dograh's LLM connection uses this.
LLM_MODEL_NAME=buzz-llm
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# Used only by the warm-up, smoke tests and benchmark on this host. The voice
# callers hear is set in Dograh (TTS_VOICE on the app host).
TTS_VOICE=bf_emma

# --- Images ------------------------------------------------------------------
# Pinned tags (PLAN section 2). After scripts/lock-digests.sh you may switch to
# tag@sha256:<digest> from versions.lock.
# vLLM v0.31.0 is CUDA 13.0. For CUDA 12.x hosts use vllm/vllm-openai:v0.31.0-cu129
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cuda-12.6.3
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.8.4
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1

# --- GPU sizing (24 GB card defaults; PLAN section 4) --------------------------
# For 16 GB or 48 GB cards, add a preset after this file:
#   docker compose --env-file .env --env-file presets/gpu-16gb.env.preset up -d
# GPU index both model servers use (nvidia-smi numbering).
GPU_DEVICE_ID=0
# Fraction of TOTAL GPU memory vLLM reserves (weights + activations + KV cache).
VLLM_GPU_MEMORY_UTILIZATION=0.50
# Longest context per request, in tokens.
VLLM_MAX_MODEL_LEN=8192
# Most sequences vLLM schedules at once.
VLLM_MAX_NUM_SEQS=16
# faster-whisper CTranslate2 compute type: float16, or int8_float16 if VRAM is tight.
WHISPER_COMPUTE_TYPE=float16

# --- Logging -----------------------------------------------------------------
# Speaches default is "debug", which logs request details. Keep "info".
SPEACHES_LOG_LEVEL=info
