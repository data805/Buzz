# Buzz app host environment (infra/app/.env). Copy with scripts/gen-secrets.sh,
# which fills every secret below with a strong random value. Never commit .env.
#
# Keys marked "Dograh" are read by the Dograh api (api/constants.py) or ui,
# via docker-compose.yml. Keys marked "shared" are defined in
# docs/INTERFACES.md and used by other components on this host.
# Fixed values (ENABLE_TELEMETRY=false, POSTHOG_API_KEY empty, MPS_API_URL
# blackhole, FORWARDED_ALLOW_IPS=172.30.0.10, ...) live in the compose file on
# purpose so they cannot be switched on from here.
#
# Secrets are hex: they go into URLs (DATABASE_URL, REDIS_URL) and coturn's
# config, so avoid characters such as @ : / % # in hand-set values.

# --- Public address (Q2: domain still TBC) ---------------------------------
# Dograh: canonical origin. BACKEND_API_ENDPOINT, MINIO_PUBLIC_ENDPOINT and
# UI_APP_URL are all set from it.
PUBLIC_BASE_URL=https://voice.bongohive.co.zm
# Dograh, nginx, coturn realm; also the default TURN host browsers dial.
PUBLIC_HOST=voice.bongohive.co.zm
# Dograh, coturn: this host's IPv4 address as browsers reach it (coturn
# external-ip). A private LAN address is fine for an internal-only install.
SERVER_IP=
# Dograh: TURN host if it differs from PUBLIC_HOST. Normally leave empty.
TURN_HOST=

# --- TLS (Q2: Let's Encrypt or internal CA) --------------------------------
# Host directory mounted read-only at /etc/nginx/certs in the nginx container.
#   Internal CA:    TLS_CERT_DIR=./certs  (fullchain.pem + privkey.pem)
#   Let's Encrypt:  TLS_CERT_DIR=/etc/letsencrypt
TLS_CERT_DIR=./certs
# Paths inside the nginx container.
#   Internal CA:    /etc/nginx/certs/fullchain.pem, /etc/nginx/certs/privkey.pem
#   Let's Encrypt:  /etc/nginx/certs/live/voice.bongohive.co.zm/fullchain.pem (and privkey.pem)
TLS_CERT_FILE=/etc/nginx/certs/fullchain.pem
TLS_KEY_FILE=/etc/nginx/certs/privkey.pem
# Webroot for certbot --webroot (HTTP-01). Unused with an internal CA.
ACME_WEBROOT=./nginx/acme

# --- Grafana behind nginx at /grafana/ -------------------------------------
# infra/monitoring attaches Grafana to buzz-app as "grafana". Host loopback
# (127.0.0.1:3000) is not reachable from the nginx container.
GRAFANA_UPSTREAM=http://grafana:3000

# --- Data services (secrets) -----------------------------------------------
# Dograh / Postgres. Baked into the volume on first start.
POSTGRES_PASSWORD=
# Dograh / Redis requirepass.
REDIS_PASSWORD=
# Dograh / MinIO root credentials (also the api's MinIO access key).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Dograh authentication and signing (secrets) ---------------------------
# Signs local-auth JWTs. 64 random bytes.
OSS_JWT_SECRET=
# Shared: signs the chan_websocket media URL tokens.
TELEPHONY_WS_TOKEN_SECRET=
# Dograh and coturn: TURN REST API shared secret.
TURN_SECRET=
# Dograh: required header X-Dograh-Devops-Secret for /api/v1/metrics.
# Give it to Prometheus (infra/monitoring) as well.
DOGRAH_DEVOPS_SECRET=

# --- Dograh behaviour ------------------------------------------------------
# false except while creating the first admin accounts (README, step 5).
ENABLE_SIGNUP=false
# Reject telephony WebSockets without a valid token. Set false only to
# diagnose, then back to true.
TELEPHONY_WS_TOKEN_ENFORCE=true
# Relay-only WebRTC; also removes Dograh's Google STUN server entry.
FORCE_TURN_RELAY=true
# Calls per organisation; match to the Phase 6 load test.
DEFAULT_ORG_CONCURRENCY_LIMIT=10
# Upload call recordings to our MinIO.
ENABLE_CALL_RECORDING_UPLOAD=true
# Extra origins allowed by the api's CORS middleware (comma-separated), e.g.
# the public site that embeds the web widget. Empty = none.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# --- Tracing: self-hosted Langfuse only (Q8). Leave empty until it exists.
# All four are needed together, or the api refuses to start.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=

# --- Shared with other components (docs/INTERFACES.md) ---------------------
# Inference server LAN address (provider bootstrap, Prometheus).
INFERENCE_HOST=
# Copy these two from the inference host's .env; do not generate new ones here.
VLLM_API_KEY=
SPEACHES_API_KEY=
LLM_MODEL_NAME=buzz-llm
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=bf_emma
# Suppression service X-API-Key; also used by Asterisk, the opt_out tool and n8n.
SUPPRESSION_API_KEY=
# Asterisk ARI user "dograh"; entered in Dograh's telephony configuration.
ARI_PASSWORD=
