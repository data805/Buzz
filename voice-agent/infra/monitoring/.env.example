# infra/monitoring/.env — copy to .env (git-ignored), fill in, then `sudo ./render.sh`.
# Shared names follow docs/INTERFACES.md.

# --- Grafana (compose reads these directly) ---
PUBLIC_HOST=voice.bongohive.co.zm          # TBC; Grafana is served at https://$PUBLIC_HOST/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                    # openssl rand -base64 24
GRAFANA_SECRET_KEY=                        # openssl rand -hex 32; never change after first start

# --- Prometheus storage ---
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB

# --- Scrape targets (render.sh writes prometheus/targets/*.json) ---
INFERENCE_HOST=                            # inference server LAN IP or hostname
DOGRAH_API_SERVICE=api                     # Compose service name of the Dograh api (infra/app)
FASTAPI_WORKERS=1                          # same as infra/app/.env; one scrape target per worker (ports 8000+N)
APP_NODE_EXPORTER_LISTEN=172.30.0.1:9100   # app-host node-exporter (host network, bound to the buzz-app gateway)
ASTERISK_HTTP=172.30.0.1:8088              # Asterisk HTTP server (ARI + res_prometheus /metrics)
SUPPRESSION_INTERNAL=suppression:8080      # suppression service on the Docker network
# VLLM_PORT=8000
# SPEACHES_PORT=8001
# DCGM_PORT=9400
# INFERENCE_NODE_EXPORTER_PORT=9100

# --- Secrets (render.sh copies them to secrets/, owned by uid 65534, mode 0400) ---
DOGRAH_DEVOPS_SECRET=                      # must equal DOGRAH_DEVOPS_SECRET in infra/app/.env
ASTERISK_METRICS_PASSWORD=                 # must equal auth_password in Asterisk prometheus.conf (user "prometheus")
ALERT_WEBHOOK_URL=                         # receiver TBD (email/Slack bridge, n8n webhook, ...); must be on the egress allow-list
