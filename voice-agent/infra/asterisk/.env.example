# Buzz Asterisk environment. Copy to .env (git-ignored). Rules: config/env.list.
# Secrets: 16+ chars of [A-Za-z0-9._~+=-]; generate with `openssl rand -hex 32`.

# --- Dograh / ARI ---
ARI_PASSWORD=change-me
# Copy from Dograh: Telephony configurations > your ARI config > Stasis App Name
DOGRAH_STASIS_APP=dograh_000000000000
DOGRAH_WS_URI=ws://127.0.0.1:8000/api/v1/telephony/ws/ari
ASTERISK_HTTP_BIND=172.30.0.1
ASTERISK_HTTP_PORT=8088
ARI_PERMIT_CIDRS=172.30.0.0/24
ASTERISK_METRICS_USER=prometheus
ASTERISK_METRICS_PASSWORD=change-me

# --- SIP and RTP ---
ASTERISK_PUBLIC_IP=203.0.113.10
ASTERISK_LAN_CIDR=10.0.0.0/24
STAFF_LAN_CIDR=10.0.0.0/24

# --- Carrier trunk (TBC with the carrier, PLAN.md section 9 Q4) ---
ZM_TRUNK_HOST=sip.carrier.example
ZM_TRUNK_PORT=5060
# Every IP/CIDR the carrier sends SIP and RTP from
ZM_TRUNK_MATCH=198.51.100.10,198.51.100.11
ZM_TRUNK_FROM_DOMAIN=
# Leave empty for an IP-authenticated trunk
ZM_TRUNK_USERNAME=
ZM_TRUNK_PASSWORD=
ZM_TRUNK_REGISTER=no
# How the carrier wants numbers: e164 (+260971234567), international (260971234567), national (0971234567)
ZM_TRUNK_NUMBER_FORMAT=e164
ZM_TRUNK_MAX_CHANNELS=10

# --- Outbound guard ---
SUPPRESSION_URL=http://127.0.0.1:8090
SUPPRESSION_API_KEY=change-me
# Number presented to called parties (a BongoHive DID that can be called back)
OUTBOUND_CLI=
OUTBOUND_RING_TIMEOUT=18
# GotoIfTime rules; end minute is inclusive (17:59 = until 18:00)
CALL_HOURS=mon-fri 08:00-17:59; sat 09:00-12:59
CALL_TIMEZONE=Africa/Lusaka
# Fixed-date public holidays with no outbound calls, e.g. 1 jan, 8 mar, 1 may, 25 dec
CALL_CLOSED_DAYS=

# --- Transfers and messages ---
TRANSFER_RING_TIMEOUT=20
# n8n webhook for take-a-message (empty = off)
MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_SECRET=
