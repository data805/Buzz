# Environment variables the Asterisk templates may use.
#
# Format: NAME|default|rule
#   rule is one of:
#     secret    required; 16+ chars from [A-Za-z0-9._~+=-] (no ; or spaces, which break Asterisk config)
#     required  must be non-empty
#     optional  may be empty
#     int       whole number
#     ipv4      dotted IPv4 address
#     cidrs     comma-separated IPv4 addresses or CIDRs
#     stasis    Dograh-generated Stasis app name (dograh_...)
#     wsuri     ws:// or wss:// URL with no query string
#     httpurl   http:// or https:// URL (empty allowed only where noted by the default)
#     choice:a/b/c  one of the listed values
#     hours / tz / days   call-hours rules, parsed by entrypoint.sh
#
# envsubst is run with exactly this list, so Asterisk dialplan variables such
# as ${EXTEN} are left alone. Rule: no name here may start with BUZZ_, because
# BUZZ_ is reserved for dialplan globals and channel variables.

# --- Dograh / ARI (INTERFACES.md) ---
ARI_PASSWORD||secret
DOGRAH_STASIS_APP||stasis
DOGRAH_WS_URI|ws://127.0.0.1:8000/api/v1/telephony/ws/ari|wsuri
ASTERISK_HTTP_BIND|172.30.0.1|ipv4
ASTERISK_HTTP_PORT|8088|int
ARI_PERMIT_CIDRS|172.30.0.0/24|cidrs
ASTERISK_METRICS_USER|prometheus|required
ASTERISK_METRICS_PASSWORD||secret

# --- SIP and RTP ---
ASTERISK_PUBLIC_IP||ipv4
ASTERISK_LAN_CIDR||cidrs
STAFF_LAN_CIDR||cidrs

# --- Carrier trunk ---
ZM_TRUNK_HOST||required
ZM_TRUNK_PORT|5060|int
ZM_TRUNK_MATCH||cidrs
ZM_TRUNK_FROM_DOMAIN||optional
ZM_TRUNK_USERNAME||optional
ZM_TRUNK_PASSWORD||optional
ZM_TRUNK_REGISTER|no|choice:yes/no
ZM_TRUNK_NUMBER_FORMAT|e164|choice:e164/international/national
ZM_TRUNK_MAX_CHANNELS|10|int

# --- Outbound guard (buzz-outbound) ---
SUPPRESSION_URL|http://127.0.0.1:8090|httpurl
SUPPRESSION_API_KEY||secret
OUTBOUND_CLI||optional
OUTBOUND_RING_TIMEOUT|18|int
CALL_HOURS|mon-fri 08:00-17:59; sat 09:00-12:59|hours
CALL_TIMEZONE|Africa/Lusaka|tz
CALL_CLOSED_DAYS||days

# --- Transfers and messages (buzz-transfer) ---
TRANSFER_RING_TIMEOUT|20|int
MESSAGE_WEBHOOK_URL||optional
MESSAGE_WEBHOOK_SECRET||optional
