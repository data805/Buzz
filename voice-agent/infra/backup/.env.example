# infra/backup/.env — copy to .env (git-ignored, mode 0600, owner root).

# The app stack's .env: provides MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (and POSTGRES_PASSWORD).
BUZZ_APP_ENV=/opt/buzz/voice-agent/infra/app/.env

BACKUP_ROOT=/srv/buzz-backups               # ideally a separate disk
AGE_RECIPIENTS_FILE=/etc/buzz/backup/age-recipients.txt   # PUBLIC keys only
TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
# OFFSITE_RSYNC_TARGET=backup@nas.internal:/volume1/buzz   # optional, encrypted files only

# Containers are found by Compose service label; override with <SERVICE>_CONTAINER=name.
PG_SERVICE=postgres
PG_USER=postgres
PG_DB=postgres                              # POSTGRES_DB in infra/app/docker-compose.yml
MINIO_SERVICE=minio
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_BUCKET=voice-audio
MC_IMAGE=buzz/mc:RELEASE.2025-08-13T08-35-41Z
SUPPRESSION_SERVICE=suppression
SUPPRESSION_DB_PATH=/data/suppression.db    # SUPPRESSION_DB_PATH in infra/app/docker-compose.yml
ASTERISK_SERVICE=asterisk
# ASTERISK_CONTAINER=buzz-asterisk           # set if Asterisk is not a Compose service named "asterisk" (verify)
ASTERISK_PATHS="etc/asterisk var/spool/asterisk/voicemail var/spool/asterisk/monitor var/spool/asterisk/recording var/lib/asterisk/sounds/buzz"

KEEP_DAILY=14
KEEP_WEEKLY=8
WEEKLY_DAY=7                                # ISO weekday of the weekly copy and MinIO full (7 = Sunday)
MINIO_INCREMENTAL_WINDOW=2d

RETENTION_DAYS=90
TAG_WINDOW_DAYS=3
KEEP_CONTEXT_KEYS=call_id,call_disposition,call_status,call_tags,call_initiation_uncertain

VERIFY_PG_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm      # same tag as infra/app/docker-compose.yml
